datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  DISCONNECTED
  ACTION_NEEDED
  EXPIRED
}

enum AccountType {
  CHECKING
  SAVINGS
  LOAN
  INVESTMENT
  MEAL_VOUCHER
  OTHER
}

model UserProfile {
  id              String           @id @default(uuid()) @db.Uuid // Corresponds to Supabase auth.users id
  email           String           @unique
  fullName        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bankConnections BankConnection[]

  @@map("user_profiles")
}

model BankConnection {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  powensItemId        Int              @unique
  institutionId       Int
  institutionName     String
  status              ConnectionStatus @default(CONNECTED)
  
  // Jetons bancaires chiffrés au repos (AES-256-GCM)
  encryptedAccessToken String
  encryptedRefreshToken String?
  
  lastSuccessfulSync  DateTime?
  lastSyncAttempt     DateTime?
  errorMessage        String?
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts            BankAccount[]
  syncLogs            SyncLog[]

  @@index([userId])
  @@map("bank_connections")
}

model BankAccount {
  id               String            @id @default(uuid()) @db.Uuid
  connectionId     String            @db.Uuid
  powensAccountId  Int               @unique
  name             String
  type             AccountType       @default(CHECKING)
  currentBalance   Decimal           @db.Decimal(12, 2)
  currency         String            @default("EUR")
  iban             String?
  isFavorite       Boolean           @default(false)
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  connection       BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]

  @@index([connectionId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                   String       @id @default(uuid()) @db.Uuid
  accountId            String       @db.Uuid
  powensTransactionId  Int          @unique
  date                 DateTime     @db.Date
  amount               Decimal      @db.Decimal(12, 2)
  currency             String       @default("EUR")
  rawDescription       String
  cleanedDescription   String?
  category             String?
  isPredicted          Boolean      @default(false)
  isExcluded           Boolean      @default(false)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  account              BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([date])
  @@map("bank_transactions")
}

model SyncLog {
  id              String         @id @default(uuid()) @db.Uuid
  connectionId    String         @db.Uuid
  status          String
  transactionsCount Int          @default(0)
  durationMs      Int            @default(0)
  details         String?
  createdAt       DateTime       @default(now())

  connection      BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("sync_logs")
}
