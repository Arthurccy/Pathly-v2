datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  DISCONNECTED
  ACTION_NEEDED
  EXPIRED
}

enum AccountType {
  CHECKING
  SAVINGS
  LOAN
  INVESTMENT
  MEAL_VOUCHER
  OTHER
}

enum AssetCategory {
  REAL_ESTATE
  VEHICLE
  WATCH
  JEWELRY
  ART
  TECH
  OTHER
}

enum LoanType {
  MORTGAGE
  AUTO
  STUDENT
  CONSUMER
  REVOLVING
}

enum InvestmentAccountType {
  PEA
  CTO
  CRYPTO
  ASSURANCE_VIE
  PER
}

enum ProjectCategory {
  REAL_ESTATE
  TRAVEL
  VEHICLE
  BUSINESS
  EMERGENCY_FUND
  WEDDING
  OTHER
}

model UserProfile {
  id              String           @id @default(uuid()) @db.Uuid // Corresponds to Supabase auth.users id
  email           String           @unique
  fullName        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bankConnections BankConnection[]
  physicalAssets  PhysicalAsset[]
  loans           LoanCredit[]
  investments     InvestmentPosition[]
  lifeProjects    LifeProject[]

  @@map("user_profiles")
}

model BankConnection {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  powensItemId        Int?             @unique
  institutionId       Int?
  institutionName     String
  institutionLogo     String?
  status              ConnectionStatus @default(CONNECTED)
  
  // Jetons bancaires chiffrés au repos (AES-256-GCM)
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  
  lastSuccessfulSync  DateTime?
  lastSyncAttempt     DateTime?
  errorMessage        String?
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts            BankAccount[]
  syncLogs            SyncLog[]

  @@index([userId])
  @@map("bank_connections")
}

model BankAccount {
  id               String            @id @default(uuid()) @db.Uuid
  connectionId     String            @db.Uuid
  powensAccountId  Int?              @unique
  name             String
  type             AccountType       @default(CHECKING)
  currentBalance   Decimal           @db.Decimal(12, 2)
  currency         String            @default("EUR")
  iban             String?
  institutionName  String?
  institutionLogo  String?
  isFavorite       Boolean           @default(false)
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  connection       BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]

  @@index([connectionId])
  @@map("bank_accounts")
}

model BankTransaction {
  id                   String       @id @default(uuid()) @db.Uuid
  accountId            String       @db.Uuid
  powensTransactionId  Int?         @unique
  date                 DateTime     @db.Date
  amount               Decimal      @db.Decimal(12, 2)
  currency             String       @default("EUR")
  rawDescription       String
  cleanedDescription   String?
  category             String?
  isPredicted          Boolean      @default(false)
  isExcluded           Boolean      @default(false)

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  account              BankAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([date])
  @@map("bank_transactions")
}

model PhysicalAsset {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  name            String        // ex: "Rolex Submariner", "BMW Série 3", "Appartement T3 Rouen"
  category        AssetCategory @default(OTHER)
  estimatedValue  Decimal       @db.Decimal(12, 2)
  purchasePrice   Decimal?      @db.Decimal(12, 2)
  purchaseDate    DateTime?     @db.Date
  currency        String        @default("EUR")
  notes           String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("physical_assets")
}

model LoanCredit {
  id                      String      @id @default(uuid()) @db.Uuid
  userId                  String      @db.Uuid
  name                    String      // ex: "Prêt Résidence Principale CIC", "Crédit Auto BMW"
  lenderInstitution       String      // ex: "CIC", "BNP", "Boursorama"
  institutionLogo         String?
  loanType                LoanType    @default(PERSONAL)
  initialAmount           Decimal     @db.Decimal(12, 2)
  remainingCapital        Decimal     @db.Decimal(12, 2)
  interestRate            Decimal     @db.Decimal(5, 2) // ex: 3.45%
  monthlyPayment          Decimal     @db.Decimal(10, 2)
  startDate               DateTime    @db.Date
  endDate                 DateTime    @db.Date
  insuranceMonthlyPayment Decimal?    @db.Decimal(10, 2)
  
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user                    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loans_credits")
}

model InvestmentPosition {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  brokerInstitution  String                // ex: "Trade Republic", "Binance", "Bourse Direct"
  institutionLogo    String?
  accountType        InvestmentAccountType @default(PEA)
  symbol             String                // ex: "AIR.PA", "CW8", "BTC", "ETH"
  name               String                // ex: "Air Liquide", "Amundi World", "Bitcoin"
  quantity           Decimal               @db.Decimal(18, 8)
  unitBuyPrice       Decimal               @db.Decimal(12, 4) // PRU
  currentPrice       Decimal               @db.Decimal(12, 4)
  currency           String                @default("EUR")
  
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user               UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, brokerInstitution])
  @@map("investment_positions")
}

model LifeProject {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  title              String          // ex: "Achat Résidence Principale", "Tour du Monde 2028"
  category           ProjectCategory @default(OTHER)
  targetAmount       Decimal         @db.Decimal(12, 2)
  currentSaved       Decimal         @db.Decimal(12, 2) @default(0)
  targetDate         DateTime        @db.Date
  monthlyAllocation  Decimal         @db.Decimal(10, 2) @default(0)
  
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("life_projects")
}

model SyncLog {
  id                String         @id @default(uuid()) @db.Uuid
  connectionId      String         @db.Uuid
  status            String
  transactionsCount Int            @default(0)
  durationMs        Int            @default(0)
  details           String?
  createdAt         DateTime       @default(now())

  connection        BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("sync_logs")
}
