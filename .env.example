# ==============================================
# PATHLY V2 - ENVIRONNEMENT MONOREPO TEMPLATE
# (Valeurs d'exemple - NE PAS METTRE DE CLES DE PRODUCTION ICI)
# ==============================================

# --- NOUVELLE INSTANCE SUPABASE V2 (Dédiée V2 - isolée de la V1) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet-supabase-v2.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_nouvelle_anon_key_supabase_v2
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_secrete_v2
SUPABASE_JWT_SECRET=votre_jwt_secret_supabase_v2

# --- PRISMA DATABASE URL (Nouvelle BDD Supabase V2) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.votre-projet-v2.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.votre-projet-v2.supabase.co:5432/postgres

# --- BACKEND API (NestJS) ---
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# --- CHIFFREMENT BANCAIRE AES-256 (32 octets / 256 bits) ---
# Clé de chiffrement au repos pour les jetons bancaires Powens
ENCRYPTION_KEY=remplacer_par_une_cle_hex_aleatoire_de_64_caracteres_32_bytes

# --- POWENS / BRIDGE API (Open Banking - Isolé sur le backend NestJS) ---
POWENS_CLIENT_ID=votre_powens_client_id_sandbox
POWENS_CLIENT_SECRET=votre_powens_client_secret_sandbox
POWENS_API_URL=https://api.bridgeapi.io
POWENS_WEBHOOK_SECRET=votre_powens_webhook_secret

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
