{
  "name": "pathly-monorepo",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-all": "turbo run lint build",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @pathly/database db:generate",
    "db:push": "pnpm --filter @pathly/database db:push",
    "db:studio": "pnpm --filter @pathly/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
